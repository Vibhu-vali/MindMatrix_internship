<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Top row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="32dp"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_heading"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:textColor="#7B2D8B"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_tagline"
                    android:textSize="15sp"
                    android:textColor="#9E9E9E"
                    android:layout_marginTop="4dp"/>

            </LinearLayout>

            <androidx.cardview.widget.CardView
                xmlns:app="http://schemas.android.com/apk/res-auto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardCornerRadius="8dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="#7B2D8B">

                <Spinner
                    android:id="@+id/spinnerLanguage"
                    android:layout_width="120dp"
                    android:layout_height="40dp"
                    android:paddingHorizontal="8dp"
                    android:gravity="center_vertical"
                    android:popupBackground="#FFFFFF"/>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="28dp"/>

        <!-- Route Card -->
        <androidx.cardview.widget.CardView
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- FROM row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_from"
                        android:textSize="11sp"
                        android:textColor="#7B2D8B"
                        android:textStyle="bold"
                        android:letterSpacing="0.1"/>

                    <!-- Use my location button -->
                    <TextView
                        android:id="@+id/btnUseLocation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📍 Use my location"
                        android:textSize="12sp"
                        android:textColor="#7B2D8B"
                        android:padding="4dp"/>

                </LinearLayout>

                <AutoCompleteTextView
                    android:id="@+id/etFrom"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:hint="@string/from_hint"
                    android:textSize="17sp"
                    android:textColor="#1A1A1A"
                    android:textColorHint="#9E9E9E"
                    android:background="@null"
                    android:paddingVertical="8dp"
                    android:completionThreshold="1"
                    android:inputType="text"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#F5F5F5"
                    android:layout_marginVertical="8dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_to"
                    android:textSize="11sp"
                    android:textColor="#2E7D32"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"/>

                <AutoCompleteTextView
                    android:id="@+id/etTo"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:hint="@string/to_hint"
                    android:textSize="17sp"
                    android:textColor="#1A1A1A"
                    android:textColorHint="#9E9E9E"
                    android:background="@null"
                    android:paddingVertical="8dp"
                    android:completionThreshold="1"
                    android:inputType="text"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Find Route Button -->
        <Button
            android:id="@+id/btnFindRoute"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:text="@string/find_route"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/button_rounded"/>

        <!-- Metro Map Button -->
        <Button
            android:id="@+id/btnMetroMap"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="@string/view_metro_map"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/button_outline"/>

        <!-- Recent Searches -->
        <LinearLayout
            android:id="@+id/layoutRecent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="28dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="RECENT SEARCHES"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:textColor="#9E9E9E"/>

                <TextView
                    android:id="@+id/tvClearRecent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Clear"
                    android:textSize="12sp"
                    android:textColor="#7B2D8B"
                    android:padding="4dp"/>

            </LinearLayout>

            <androidx.cardview.widget.CardView
                xmlns:app="http://schemas.android.com/apk/res-auto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:id="@+id/containerRecent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp"/>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </LinearLayout>
</ScrollView>